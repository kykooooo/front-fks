rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isClubOwner(clubId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid == request.auth.uid;
    }

    function isCoach(clubId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role == "coach";
    }

    // Membre du club = possède un doc members/{uid} (joueur OU coach).
    // Tout joueur ayant rejoint via code en a un (setClubMembership).
    function isClubMember(clubId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid));
    }

    // La JOUEUSE ciblée est-elle un membre ACTIF du club, avec le rôle player ?
    // Sert à invalider une projection playerSummaries STALE : si la joueuse a
    // quitté le club (member doc supprimé) ou n'a pas le rôle player (coach/rôle
    // invalide), le summary — même encore présent — n'est plus lisible.
    // exists() protège le get() (court-circuit) contre un doc absent.
    function isPlayerMember(clubId, playerUid) {
      return exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(playerUid)) &&
        get(/databases/$(database)/documents/clubs/$(clubId)/members/$(playerUid)).data.role == "player";
    }

    // Frontière coach-safe (PR-4) : les docs BRUTS de la joueuse (profil, séances
    // faites, séances planifiées) sont STRICTEMENT privés — seule la propriétaire
    // y accède. Le coach ne lit JAMAIS ces docs : sa seule surface de lecture est
    // la projection serveur clubs/{clubId}/playerSummaries (plus bas), écrite par
    // Cloud Function et filtrée des champs médicaux/intimes/charge brute.
    // La relation coach↔joueuse n'est plus dérivée d'un clubId lu dans le doc
    // (potentiellement falsifiable par la joueuse) : elle est vérifiée par le
    // membership réel du coach dans le club (isCoach), via le clubId du CHEMIN.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /plannedSessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // Preuve d'invitation (anti self-join) : le doc member écrit par le client
    // doit porter `inviteCode`, comparé au code RÉEL du club (get() serveur,
    // qui ignore les permissions de lecture du client). Le code = capability :
    // sans lui, impossible de se créer un membership player.
    function providesClubInviteCode(clubId) {
      return ("inviteCode" in request.resource.data) &&
        request.resource.data.inviteCode is string &&
        request.resource.data.inviteCode ==
          get(/databases/$(database)/documents/clubs/$(clubId)).data.inviteCode;
    }

    match /clubs/{clubId} {
      // Énumération FERMÉE : plus AUCUNE lecture de collection (list). Un
      // getDocs(clubs) — même paginé doc par doc — est refusé pour tout client.
      // La découverte d'un club se fait par /inviteCodes/{code} (get par code
      // exact, plus bas) : il faut CONNAÎTRE le code, on ne peut plus le récolter.
      allow list: if false;
      // get par ID : réservé aux membres du club (joueur OU coach) et à l'owner.
      // `resource.data.ownerUid` (doc déjà chargé) évite un get() redondant.
      allow get: if isClubMember(clubId) ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isClubOwner(clubId);
      allow delete: if false;

      match /members/{memberId} {
        // Lecture : le membre lui-même, un coach du club, OU l'owner du club.
        // `isClubOwner` est aligné EXPLICITEMENT sur la lecture de playerSummaries
        // (même couple coach/owner) : le lecteur du roster (members → summaries)
        // doit pouvoir lister les members avant de lire chaque projection.
        allow read: if isOwner(memberId) || isCoach(clubId) || isClubOwner(clubId);
        // Écriture de SON membership uniquement, et :
        //  - player : exige la PREUVE de l'invitation (inviteCode exact du club
        //    dans le doc) — ferme le self-join d'un inconnu dans l'effectif ;
        //  - coach : réservé à l'owner du club (inchangé).
        // update soumis à la même preuve : un membre existant ne peut pas
        // réécrire son doc sans re-fournir le code (seul flux d'écriture légitime
        // = rejoindre via code ; il porte toujours le code).
        allow create, update: if isOwner(memberId) && (
          (request.resource.data.role == "player" && providesClubInviteCode(clubId)) ||
          (request.resource.data.role == "coach" && isClubOwner(clubId))
        );
        // Un membre peut se retirer lui-même, ou le owner du club peut retirer n'importe qui
        allow delete: if isOwner(memberId) || isClubOwner(clubId);
      }

      // Contexte de semaine : lecture réservée aux MEMBRES du club (joueur ou
      // coach) + owner. Un utilisateur connecté hors du club ne peut pas lire.
      // Écriture réservée au coach (le joueur n'écrit jamais). Delete = owner.
      match /weekContexts/{weekKey} {
        allow read: if isClubMember(clubId) || isClubOwner(clubId);
        allow create, update: if isCoach(clubId);
        allow delete: if isClubOwner(clubId);
      }

      // Projection coach-safe (PR-4) : unique surface de lecture du coach sur les
      // données joueuses. Produite EXCLUSIVEMENT par une Cloud Function (admin SDK,
      // qui contourne les rules) — d'où `write: if false` : AUCUN client (ni coach,
      // ni joueuse, ni owner) ne peut écrire/altérer une projection.
      // Lecture autorisée SEULEMENT si le lecteur est coach/owner du club (relation
      // vérifiée par membership sur le clubId du CHEMIN, jamais un clubId client) ET
      // si la JOUEUSE ciblée est TOUJOURS membre player du club (isPlayerMember).
      // Ce second garde-fou ferme la fuite d'un summary STALE : après le départ de
      // la joueuse, sa projection résiduelle devient illisible (fail-closed).
      // Par DESIGN, toute lecture list / getDocs de playerSummaries est REFUSÉE :
      // la règle dépend de l'ID du document (isPlayerMember(playerUid)), non
      // évaluable en list. Seules les lectures DIRECTES par playerUid d'une joueuse
      // ENCORE membre player sont autorisées (le lecteur front liste members, puis
      // lit chaque summary par son ID).
      match /playerSummaries/{playerUid} {
        allow read: if (isCoach(clubId) || isClubOwner(clubId)) &&
          isPlayerMember(clubId, playerUid);
        allow write: if false;
      }
    }

    // Annuaire code→club : l'ID du doc EST le code d'invitation (normalisé).
    // Remplace l'ancienne query `clubs where inviteCode ==` (impossible à
    // sécuriser : les rules ne voient pas les clauses where d'une list, donc
    // toute list sur clubs restait énumérable par pagination).
    //  - get par code exact : autorisé à tout connecté — il faut CONNAÎTRE le
    //    code (capability), on ne peut pas le découvrir ;
    //  - list : interdite → énumération impossible ;
    //  - contenu volontairement minimal et non sensible : clubId + name
    //    (affichage "Tu as rejoint {name}"), PAS d'ownerUid ;
    //  - create : uniquement par l'owner du club référencé, et seulement si le
    //    code est COHÉRENT (clubs/{clubId}.inviteCode == code) — personne ne
    //    peut planter un faux annuaire vers un club qui n'est pas le sien ;
    //  - update/delete : interdits (pas de rotation de code aujourd'hui ; un
    //    setDoc sur un code existant est un update → refusé = anti-écrasement).
    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() &&
        request.resource.data.clubId is string &&
        get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.ownerUid == request.auth.uid &&
        get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.inviteCode == code;
      allow update, delete: if false;
    }
  }
}
