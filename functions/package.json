{
  "name": "fks-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Functions FKS — producteur de projections coach-safe (clubs/{clubId}/playerSummaries/{playerUid}).",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand --forceExit",
    "backfill": "node lib/backfill.js",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  }
}
